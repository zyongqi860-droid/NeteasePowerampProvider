<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/share_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/pa_bg"
	android:gravity="center_vertical"
	android:orientation="vertical"
	android:paddingStart="24dp"
	android:paddingEnd="24dp">

	<TextView
		android:id="@+id/share_title"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="@string/share_preparing"
		style="@style/PaTitle" />

	<TextView
		android:id="@+id/share_subtitle"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="4dp"
		android:text="@string/share_target_dir"
		style="@style/PaSection" />

	<ProgressBar
		android:id="@+id/share_progress"
		style="?android:attr/progressBarStyleHorizontal"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="20dp"
		android:indeterminate="true" />

	<TextView
		android:id="@+id/share_status"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="6dp"
		android:text="@string/share_status_starting"
		style="@style/PaStatus" />

	<Button
		android:id="@+id/btn_share_done"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="24dp"
		android:enabled="false"
		android:text="@string/share_done"
		style="@style/PaButton.Primary" />
</LinearLayout>
