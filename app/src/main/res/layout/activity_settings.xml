<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fillViewport="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="16dp">

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/settings_authority_label" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:textIsSelectable="true"
			android:textStyle="bold"
			android:text="@string/settings_authority_value" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:text="@string/settings_status_label" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:text="@string/settings_track_label" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/settings_album_label" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="24dp"
			android:textStyle="bold"
			android:text="@string/qr_section_title" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:text="@string/qr_help" />

		<Button
			android:id="@+id/btn_qr_login"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:text="@string/qr_button" />

		<ImageView
			android:id="@+id/qr_code"
			android:layout_width="240dp"
			android:layout_height="240dp"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="8dp"
			android:contentDescription="@string/qr_section_title"
			android:scaleType="fitCenter" />

		<TextView
			android:id="@+id/qr_status"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:gravity="center_horizontal"
			android:text="@string/qr_status_idle" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="24dp"
			android:textStyle="bold"
			android:text="@string/login_section_title" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:text="@string/login_help" />

		<EditText
			android:id="@+id/login_phone"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:singleLine="true"
			android:inputType="phone"
			android:hint="@string/login_phone_hint"
			android:imeOptions="actionNext" />

		<EditText
			android:id="@+id/login_password"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:singleLine="true"
			android:inputType="textPassword"
			android:hint="@string/login_password_hint"
			android:imeOptions="actionDone" />

		<Button
			android:id="@+id/btn_login"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:text="@string/login_button" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="24dp"
			android:textStyle="bold"
			android:text="@string/cookie_section_title" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:text="@string/cookie_help" />

		<EditText
			android:id="@+id/cookie_input"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:singleLine="true"
			android:hint="@string/cookie_input_hint"
			android:imeOptions="actionDone"
			android:fontFamily="monospace"
			android:textSize="12sp" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:orientation="horizontal">

			<Button
				android:id="@+id/btn_save_cookie"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/cookie_save" />

			<Button
				android:id="@+id/btn_verify_cookie"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/cookie_verify" />

			<Button
				android:id="@+id/btn_clear_cookie"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/cookie_clear" />
		</LinearLayout>

		<TextView
			android:id="@+id/cookie_status"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:text="@string/cookie_status_anonymous" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:text="@string/settings_poweramp_label" />

		<TextView
			android:id="@+id/poweramp_status"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/poweramp_not_detected" />
	</LinearLayout>
</ScrollView>
