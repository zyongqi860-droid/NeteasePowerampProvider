<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/main_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/pa_bg"
	android:orientation="vertical">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/pa_surface"
		android:orientation="vertical"
		android:paddingStart="16dp"
		android:paddingEnd="16dp"
		android:paddingTop="12dp"
		android:paddingBottom="12dp">

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/main_activity_label"
			style="@style/PaTitle" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<EditText
				android:id="@+id/search_keyword"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:hint="@string/search_hint"
				android:imeOptions="actionSearch"
				android:inputType="text"
				android:maxLines="1"
				style="@style/PaInput" />

			<Button
				android:id="@+id/btn_search"
				android:onClick="startSearch"
				android:text="@string/btn_search"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="8dp"
				style="@style/PaButton.Primary" />
		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<EditText
				android:id="@+id/playlist_id"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:hint="@string/playlist_id_hint"
				android:inputType="number"
				android:maxLines="1"
				style="@style/PaInput" />

			<Button
				android:id="@+id/btn_import_playlist"
				android:onClick="importPlaylist"
				android:text="@string/btn_import_playlist"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="8dp"
				style="@style/PaButton.Secondary" />
		</LinearLayout>
	</LinearLayout>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingStart="16dp"
		android:paddingEnd="16dp"
		android:paddingTop="10dp"
		android:paddingBottom="4dp"
		android:text="@string/search_header"
		style="@style/PaSection" />

	<ListView
		android:id="@+id/search_results"
		android:layout_width="match_parent"
		android:layout_height="128dp"
		android:divider="@color/pa_divider"
		android:dividerHeight="1dp"
		android:nestedScrollingEnabled="true" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingStart="16dp"
		android:paddingEnd="8dp"
		android:paddingTop="8dp">

		<TextView
			android:id="@+id/library_header"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/library_header"
			style="@style/PaSection" />

		<Button
			android:id="@+id/btn_select_all"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:minHeight="36dp"
			android:minWidth="0dp"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:text="@string/library_select_all"
			style="@style/PaButton.Secondary" />

		<Button
			android:id="@+id/btn_delete_selected"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:minHeight="36dp"
			android:layout_marginStart="6dp"
			android:minWidth="0dp"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:text="@string/library_delete_selected"
			style="@style/PaButton.Danger" />
	</LinearLayout>

	<ListView
		android:id="@+id/saved_songs"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:divider="@color/pa_divider"
		android:dividerHeight="1dp"
		android:nestedScrollingEnabled="true" />

	<TextView
		android:id="@+id/status"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/pa_surface"
		android:paddingStart="16dp"
		android:paddingEnd="16dp"
		android:paddingTop="8dp"
		android:paddingBottom="4dp"
		android:text="@string/main_status_idle"
		style="@style/PaStatus" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/pa_surface"
		android:orientation="horizontal"
		android:paddingStart="12dp"
		android:paddingEnd="12dp"
		android:paddingBottom="8dp">

		<Button
			android:id="@+id/btn_sync"
			android:onClick="syncProvider"
			android:text="@string/btn_sync"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			style="@style/PaButton.Primary" />

		<Button
			android:id="@+id/btn_settings"
			android:onClick="openSettings"
			android:text="@string/btn_open_settings"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="8dp"
			android:layout_weight="1"
			style="@style/PaButton.Secondary" />
	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/pa_surface"
		android:orientation="horizontal"
		android:paddingStart="12dp"
		android:paddingEnd="12dp"
		android:paddingBottom="12dp">

		<Button
			android:id="@+id/btn_check"
			android:onClick="checkProviderConfig"
			android:text="@string/btn_check_provider"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			style="@style/PaButton.Secondary" />

		<Button
			android:id="@+id/btn_pa_folders"
			android:onClick="openPowerampMusicFolders"
			android:text="@string/btn_open_pa_music_folders"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="8dp"
			android:layout_weight="1"
			style="@style/PaButton.Secondary" />
	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/pa_surface"
		android:orientation="horizontal"
		android:paddingStart="12dp"
		android:paddingEnd="12dp"
		android:paddingBottom="12dp">

		<Button
			android:id="@+id/btn_floating"
			android:onClick="toggleFloatingSearch"
			android:text="@string/btn_floating_search"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			style="@style/PaButton.Primary" />
	</LinearLayout>
</LinearLayout>
