<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/pa_bg"
	android:orientation="vertical">

	<TextView
		android:id="@+id/web_login_status"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/pa_surface"
		android:padding="14dp"
		android:text="@string/web_login_status_loading"
		android:textColor="@color/pa_text"
		android:textSize="14sp" />

	<ProgressBar
		android:id="@+id/web_login_progress"
		style="?android:attr/progressBarStyleHorizontal"
		android:layout_width="match_parent"
		android:layout_height="3dp"
		android:max="100"
		android:visibility="gone" />

	<WebView
		android:id="@+id/web_login"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1" />
</LinearLayout>
