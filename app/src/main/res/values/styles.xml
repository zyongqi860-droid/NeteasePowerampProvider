<?xml version="1.0" encoding="utf-8"?>
<resources>
	<style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
		<item name="android:colorPrimary">@color/pa_surface</item>
		<item name="android:colorPrimaryDark">@color/pa_status_bar</item>
		<item name="android:colorAccent">@color/pa_accent</item>
		<item name="android:windowBackground">@color/pa_bg</item>
		<item name="android:statusBarColor">@color/pa_status_bar</item>
		<item name="android:navigationBarColor">@color/pa_status_bar</item>
		<item name="android:textColorPrimary">@color/pa_text</item>
		<item name="android:textColorSecondary">@color/pa_text_secondary</item>
		<item name="android:textColorHint">@color/pa_hint</item>
		<item name="android:editTextColor">@color/pa_text</item>
		<item name="android:colorControlActivated">@color/pa_accent</item>
		<item name="android:colorControlNormal">@color/pa_hint</item>
		<item name="android:colorButtonNormal">@color/pa_surface_alt</item>
		<item name="android:buttonStyle">@style/PaButton.Secondary</item>
		<item name="android:alertDialogTheme">@style/PaDialog</item>
	</style>

	<style name="PaDialog" parent="@android:style/Theme.Material.Dialog.Alert">
		<item name="android:colorAccent">@color/pa_accent</item>
		<item name="android:textColorPrimary">@color/pa_text</item>
		<item name="android:background">@color/pa_surface</item>
		<item name="android:windowBackground">@color/pa_surface</item>
	</style>

	<style name="PaTitle">
		<item name="android:textColor">@color/pa_text</item>
		<item name="android:textSize">20sp</item>
		<item name="android:textStyle">bold</item>
		<item name="android:letterSpacing">0.02</item>
	</style>

	<style name="PaSection">
		<item name="android:textColor">@color/pa_accent</item>
		<item name="android:textSize">13sp</item>
		<item name="android:textStyle">bold</item>
		<item name="android:textAllCaps">true</item>
		<item name="android:letterSpacing">0.08</item>
	</style>

	<style name="PaHint">
		<item name="android:textColor">@color/pa_text_secondary</item>
		<item name="android:textSize">12sp</item>
	</style>

	<style name="PaStatus">
		<item name="android:textColor">@color/pa_text_secondary</item>
		<item name="android:textSize">12sp</item>
		<item name="android:fontFamily">monospace</item>
	</style>

	<style name="PaInput">
		<item name="android:background">@drawable/bg_input</item>
		<item name="android:textColor">@color/pa_text</item>
		<item name="android:textColorHint">@color/pa_hint</item>
		<item name="android:paddingStart">12dp</item>
		<item name="android:paddingEnd">12dp</item>
		<item name="android:paddingTop">10dp</item>
		<item name="android:paddingBottom">10dp</item>
		<item name="android:textSize">15sp</item>
		<item name="android:minHeight">44dp</item>
	</style>

	<style name="PaButton" parent="@android:style/Widget.Material.Button">
		<item name="android:textAllCaps">false</item>
		<item name="android:textStyle">bold</item>
		<item name="android:textSize">14sp</item>
		<item name="android:minHeight">44dp</item>
		<item name="android:stateListAnimator">@null</item>
		<item name="android:elevation">0dp</item>
	</style>

	<style name="PaButton.Primary">
		<item name="android:background">@drawable/bg_button_primary</item>
		<item name="android:textColor">@color/pa_text</item>
	</style>

	<style name="PaButton.Secondary">
		<item name="android:background">@drawable/bg_button_secondary</item>
		<item name="android:textColor">@color/pa_text</item>
	</style>

	<style name="PaButton.Danger">
		<item name="android:background">@drawable/bg_button_danger</item>
		<item name="android:textColor">@color/pa_text</item>
	</style>
</resources>
